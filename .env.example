# TEMPLATE ONLY (safe to commit). Copy this file to a new file named .env and fill in real values.
# The code reads ONLY the file named .env

SPORTRADAR_API_KEY=your_sportradar_trial_key
SPORTRADAR_ACCESS_LEVEL=trial
SPORTRADAR_LANGUAGE=en

# ---- Option A: Aiven (cloud MySQL) ----
DB_HOST=your-service.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_NAME=tennis_db
DB_SSL_CA=certs/ca.pem

# ---- Option B: local MySQL (Workbench). Use these 5 lines INSTEAD of the Aiven block above ----
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_local_password
# DB_NAME=tennis_db
# (leave DB_SSL_CA out for local MySQL)